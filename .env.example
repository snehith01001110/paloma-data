# Scoped server-side worker connection. Never expose this to the iOS app.
SUPABASE_DB_URL=postgresql://paloma_ingest:password@db.example.supabase.co:5432/postgres
# Server-only credentials used to upload immutable image variants. A modern Supabase secret
# key is preferred; SUPABASE_SERVICE_ROLE_KEY remains supported for older projects.
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=

# Worker identity appears in private attempt audits. Managed runtimes should set a stable
# service/revision prefix; an instance suffix is generated automatically when omitted.
PALOMA_PIPELINE_REQUESTER=local_cli
PALOMA_WORKER_ID=

# Optional source overrides.
DATASF_DATASET_ID=g8m3-pdis
ABC_REPORTS_URL=https://www.abc.ca.gov/licensing/licensing-reports/
# Broad SF Bay Area + Napa/Sonoma bbox: west,south,east,north.
PALOMA_OVERTURE_BBOX=-123.2,36.8,-121.1,38.9

# Bay Area rollout guardrails.
PALOMA_COUNTRIES=US
PALOMA_REGIONS=CA
PALOMA_CITIES=San Francisco,Oakland,Berkeley,San Jose,San Mateo,Palo Alto,Mountain View,Sunnyvale,Santa Clara,Redwood City,Napa,Sonoma

# Free FSQ OS bulk discovery (Places Portal Iceberg connection snippet).
FSQ_CATALOG_URI=
FSQ_CATALOG_TOKEN=
FSQ_PLACES_TABLE=
FSQ_CATALOG_WAREHOUSE=

# Targeted rich/current verification. Persist API fields only under an agreement that allows it.
FSQ_PLACES_API_KEY=
# Self-service PAYG/Sandbox API attributes cannot be cached server-side. Set true only if a
# written Foursquare agreement expressly grants Paloma server retention + display rights.
FSQ_SERVER_STORAGE_LICENSED=false
# Optional Yelp overlay. The scheduled job retains only strictly matched durable business IDs;
# validated on-demand Business Details responses are cached privately for at most 22 hours.
YELP_API_KEY=
CATALOG_PROVIDER_LEASE_DAYS=45

# Open street imagery discovery. Use a Paloma-owned Mapillary client token in production.
# Signed thumbnail URLs are review-only and are never durable catalog values.
MAPILLARY_ACCESS_TOKEN=

# Emergency override only: normal snapshots abort instead of retiring >50% of a source.
PALOMA_ALLOW_SNAPSHOT_SHRINK=false

# Public-domain SF Find boundary feed. Other cities stay null until a reviewed feed is added.
SF_NEIGHBORHOODS_URL=https://data.sfgov.org/resource/gfpk-269f.geojson?$limit=5000
